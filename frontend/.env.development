# 开发环境配置。
# VITE_API_BASE: 前端 /api 由 vite proxy 转发到后端（见 vite.config.ts）。
VITE_API_BASE=/api

# 登录模式：
#   false = 走 Keycloak SSO（需本地 Keycloak 在 8080，见 backend/docker-compose.yml）
#   true  = mock 模式（任意账号密码，不需要 Keycloak）
# 不设该变量时，代码缺省为 mock（见 src/api/auth.ts）。
VITE_USE_MOCK=false

# Keycloak 连接（不设则用代码缺省）：
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=saas-platform
# VITE_KEYCLOAK_CLIENT_ID=approval-web
